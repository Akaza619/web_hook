# ---------------------------------------------------------------------------
# Copy this file to ".env" and replace the placeholder values.
# ".env" is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Pinhire Webhook Server
APP_VERSION=0.1.0
APP_ENV=development
CANDIDATE_ID=PH-2026-3126
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Security (REQUIRED in production, no usable default)
# Generate a strong value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNING_SECRET=replace-me-with-a-strong-random-secret
SIGNATURE_HEADER=x-pinhire-hmac-3126

# Webhook payload contract
TX_REF_FIELD=payload.tx_ref_3126

# Business rules
# Maximum refund in AED. Change to 255 for the Phase 4 demonstration, then restart.
REFUND_LIMIT_AED=320
IDEMPOTENCY_TTL_SECONDS=300
FAQ_LATENCY_TARGET_MS=650
# How long predefined FAQ answers stay in the Redis cache (1-604800 seconds).
FAQ_CACHE_TTL_SECONDS=3600

# Redis (REQUIRED in production)
# Hosted providers normally inject REDIS_URL (including credentials) directly.
# Never commit real credentials; this placeholder is for local development only.
REDIS_URL=redis://localhost:6379/0
# Connect/socket/PING timeout in seconds (0.1-30.0)
REDIS_TIMEOUT_SECONDS=2.0
